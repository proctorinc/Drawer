ENV="development"
PORT="8080"
# Clerk > API keys. Use the Development instance's sk_test_ key locally.
CLERK_SECRET_KEY="<ENTER CLERK SECRET KEY HERE>"
# Optional: the email you sign in to Clerk with locally, so you sign in as the seeded admin (user1)
DEV_USER_EMAIL=""
# Optional: fallback OpenAI key for the AI judges. A key saved in Admin > AI judges wins over this.
OPENAI_API_KEY=""
# Optional: an OpenAI-compatible endpoint (proxy/gateway) instead of api.openai.com
OPENAI_BASE_URL=""
